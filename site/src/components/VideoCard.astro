---
// Video card. Long-form videos link to /watch/<slug>/; Shorts (short=true) play in place:
// the shared facade script in Base.astro swaps .vthumb for a youtube-nocookie iframe on click.
import { YT_PLAY } from "../lib/icons.js";
import { fmtDate } from "../lib/articles.js";
interface Props { v: any; short?: boolean; showDate?: boolean }
const { v, short = false, showDate = false } = Astro.props;
const href = v.slug ? `/watch/${v.slug}/` : v.url;
const ext = !v.slug;
---
{short ? (
  <button class="vcard" type="button" data-vid={v.id} aria-label={`Play Short: ${v.title}`}>
    <div class="vthumb"><img src={v.thumb} alt={v.title} width="480" height="360" loading="lazy" decoding="async" /><span class="play" set:html={YT_PLAY}></span></div>
    <div class="vb">{v.title}</div>
  </button>
) : (
  <a class="vcard" href={href} {...(ext ? { target: "_blank", rel: "noopener" } : {})}>
    <div class="vthumb"><img src={v.thumb} alt={v.title} width="480" height="360" loading="lazy" decoding="async" /><span class="play" set:html={YT_PLAY}></span></div>
    <div><div class="vb">{v.title}</div>{showDate && v.published && <div class="vmeta">{fmtDate(v.published)}</div>}</div>
  </a>
)}
