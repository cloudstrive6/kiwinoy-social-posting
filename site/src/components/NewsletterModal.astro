---
// BOSS KG newsletter opt-in popup. Dialog on desktop, bottom sheet on phones.
// Frequency-capped: dismiss = 7-day cooldown, subscribe = never again (localStorage key kg_nl_pop).
// Timing (2026-11-11 decision, reversible): on article pages it opens only once the reader has
// scrolled 92% of the page (they have finished the story and seen Up next) or on desktop exit intent;
// never on a timer mid-story. Every other page keeps 55% scroll or 18 seconds.
// Single email field, posts to the same /.netlify/functions/subscribe endpoint.
import { ICON } from "../lib/icons.js";
---
<div class="nl-pop" id="nlPop" role="dialog" aria-modal="true" aria-labelledby="nlPopTitle" hidden data-pagefind-ignore>
  <div class="nl-pop-backdrop" data-nl-close></div>
  <div class="nl-pop-card" tabindex="-1">
    <button class="nl-pop-x" type="button" aria-label="Close" data-nl-close set:html={ICON.close}></button>

    <div class="nl-pop-body">
      <span class="nl-pop-label">Free newsletter</span>
      <h2 id="nlPopTitle">Get the KG Drop</h2>
      <p class="nl-pop-sub">The biggest gaming and Marvel stories in your inbox, a few times a week.</p>
      <ul class="nl-pop-list">
        <li><Fragment set:html={ICON.gamepad} />New games, trailers and release dates first</li>
        <li><Fragment set:html={ICON.film} />MCU breakdowns and the leaks that matter</li>
        <li><Fragment set:html={ICON.bolt} />A few emails a week. No spam, ever.</li>
      </ul>
      <form class="nl-pop-form" id="nlPopForm" novalidate>
        <input type="email" name="email" placeholder="you@email.com" autocomplete="email" inputmode="email" required aria-label="Email address" />
        <button class="btn btn-primary" type="submit">Get the Drop</button>
      </form>
      <p class="nl-pop-fine">Free. Unsubscribe anytime.</p>
      <button class="nl-pop-nope" type="button" data-nl-close>Maybe later</button>
    </div>

    <div class="nl-pop-done" hidden>
      <div class="nl-pop-check" set:html={ICON.check}></div>
      <h2>Welcome aboard.</h2>
      <p>Check your inbox: your welcome email is on the way.</p>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var pop = document.getElementById("nlPop");
    if (!pop) return;

    var KEY = "kg_nl_pop";        // { t: <ms>, sub: <bool> }
    var DAYS = 7;                 // dismiss cooldown (subscribers are never shown again)
    var ARTICLE = document.body && document.body.getAttribute("data-page") === "article";
    var DELAY = ARTICLE ? 0 : 18000;          // no timer on articles: never interrupt a story
    var SCROLL_AT = ARTICLE ? 0.92 : 0.55;    // fraction of the page scrolled

    function state() { try { return JSON.parse(localStorage.getItem(KEY)); } catch (e) { return null; } }
    function subscribed() { var s = state(); return !!(s && s.sub); }
    function suppressed() {
      var s = state();
      if (!s) return false;
      if (s.sub) return true;
      return (Date.now() - s.t) < DAYS * 864e5;
    }
    function remember(sub) {
      try { localStorage.setItem(KEY, JSON.stringify({ t: Date.now(), sub: !!sub })); } catch (e) {}
    }

    if (suppressed()) return;

    var shown = false, closed = false, lastFocus = null;

    function open() {
      if (shown || suppressed()) return;
      shown = true;
      lastFocus = document.activeElement;
      pop.hidden = false;
      requestAnimationFrame(function () { pop.classList.add("on"); });
      document.documentElement.style.overflow = "hidden";
      // Everything behind the dialog leaves the tab order and the accessibility tree.
      [].forEach.call(document.body.children, function (el) {
        if (el === pop || el.tagName === "SCRIPT" || el.hasAttribute("inert")) return;
        el.setAttribute("inert", ""); el.setAttribute("data-nl-inert", "");
      });
      // Focus moves into the dialog at every width: the email field on desktop, the dialog
      // itself on phones (announces the heading without popping the keyboard).
      var inp = pop.querySelector('input[type="email"]');
      var card = pop.querySelector(".nl-pop-card");
      var desk = window.matchMedia("(min-width:700px)").matches;
      try { (desk && inp ? inp : card).focus({ preventScroll: true }); } catch (e) {}
    }

    function close() {
      if (closed) return;
      closed = true;
      cleanup();
      pop.classList.remove("on");
      document.documentElement.style.overflow = "";
      [].forEach.call(document.querySelectorAll("[data-nl-inert]"), function (el) {
        el.removeAttribute("inert"); el.removeAttribute("data-nl-inert");
      });
      setTimeout(function () { pop.hidden = true; }, 260);
      if (!subscribed()) remember(false);
      if (lastFocus && lastFocus.focus) { try { lastFocus.focus(); } catch (e) {} }
    }

    // ---- triggers ----
    var timer = DELAY ? setTimeout(open, DELAY) : 0;
    var fine = window.matchMedia("(hover:hover) and (pointer:fine)").matches;

    function onExit(e) { if (e.clientY <= 0 && !e.relatedTarget) { clearTimeout(timer); open(); } }
    if (fine) document.addEventListener("mouseout", onExit);

    function onScroll() {
      var h = document.documentElement.scrollHeight - window.innerHeight;
      if (h > 0 && (window.scrollY / h) > SCROLL_AT) { clearTimeout(timer); open(); }
    }
    window.addEventListener("scroll", onScroll, { passive: true });

    function cleanup() {
      document.removeEventListener("mouseout", onExit);
      window.removeEventListener("scroll", onScroll);
    }

    // ---- close handlers (click covers taps too; touchend for stubborn iOS Safari) ----
    pop.querySelectorAll("[data-nl-close]").forEach(function (el) {
      el.addEventListener("click", close);
      el.addEventListener("touchend", function (e) { e.preventDefault(); close(); }, { passive: false });
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && shown && !pop.hidden) close();
    });

    // ---- light focus trap ----
    pop.addEventListener("keydown", function (e) {
      if (e.key !== "Tab") return;
      var f = [].slice.call(pop.querySelectorAll("button, input")).filter(function (el) {
        return !el.disabled && el.offsetParent !== null;
      });
      if (!f.length) return;
      var first = f[0], last = f[f.length - 1];
      if (f.indexOf(document.activeElement) === -1) { e.preventDefault(); (e.shiftKey ? last : first).focus(); return; }
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });

    // ---- submit ----
    var form = document.getElementById("nlPopForm");
    form.addEventListener("submit", async function (e) {
      e.preventDefault();
      var inp = form.querySelector('input[type="email"]');
      var email = (inp.value || "").trim();
      if (!email) { inp.focus(); return; }
      var btn = form.querySelector("button");
      btn.disabled = true; btn.textContent = "Joining";
      var ok = false;
      try {
        var r = await fetch("/.netlify/functions/subscribe", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email: email }),
        });
        ok = r.ok;
      } catch (err) {}
      if (ok) {
        remember(true);
        pop.querySelector(".nl-pop-body").hidden = true;
        pop.querySelector(".nl-pop-done").hidden = false;
        setTimeout(close, 3400);
      } else {
        btn.disabled = false; btn.textContent = "Try again";
        var er = form.parentElement.querySelector(".nl-pop-err");
        if (!er) { er = document.createElement("p"); er.className = "nl-pop-err"; form.insertAdjacentElement("afterend", er); }
        er.textContent = "That did not go through. Please try again in a moment.";
      }
    });
  })();
</script>
