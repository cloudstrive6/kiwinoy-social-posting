---
// Section chips under the header (home, sections, hubs): one tap to a section on phones and tablets.
// Desktop hides it (the main nav is visible there). Phones show the four news sections in one row
// (Games, Videos and Gear stay in the menu), so the row never scrolls sideways.
interface Props { current?: string }
const { current = "" } = Astro.props;
const items = [
  { label: "Latest", href: "/category/news/" },
  { label: "Marvel games", href: "/category/marvel-games/" },
  { label: "MCU", href: "/category/mcu/" },
  { label: "PlayStation", short: "PS5", href: "/category/playstation/" },
  { label: "Games", href: "/games/", wide: true },
  { label: "Videos", href: "/videos/", wide: true },
  { label: "Gear", href: "/gear/", wide: true },
];
---
<nav class="section-nav" aria-label="Sections">
  <ul>
    {items.map((i) => (
      <li class={i.wide ? "wide" : undefined}>
        <a href={i.href} aria-current={current === i.href ? "page" : undefined}>
          {i.short ? <><span class="long">{i.label}</span><span class="short">{i.short}</span></> : i.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
