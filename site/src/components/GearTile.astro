---
// One gear product: cut-out photo on the dark product tile, name, note, affiliate button.
import { imgAttrs, SIZES } from "../lib/img.js";
interface Props { g: any; h?: "h3" | "h4"; eager?: boolean }
const { g, h = "h3", eager = false } = Astro.props;
const H = h;
const live = g.url && g.url !== "#";
const im = imgAttrs(g.img, { width: 800, height: 600, sizes: SIZES.gear });
---
<div class="gear-tile">
  {im && (
    <div class="gear-photo">
      <img src={im.src} srcset={im.srcset} sizes={im.sizes} width={im.width} height={im.height} alt={g.name}
        loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : undefined} decoding="async" />
    </div>
  )}
  <div class="gear-info">
    <span class="chip">{g.cat}</span>
    <H>{g.name}</H>
    <p>{g.note}</p>
    {live
      ? <a class="btn btn-primary" href={g.url} target="_blank" rel="sponsored nofollow noopener">View on {g.retailer}</a>
      : <span class="btn" aria-disabled="true">Link coming soon</span>}
  </div>
</div>
