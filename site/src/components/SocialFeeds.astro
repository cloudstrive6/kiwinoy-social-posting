---
// Social highlight feeds (restored 2026-11-12 at Bryce's request; the redesign had dropped them).
// Three cards: Instagram and TikTok with three recent reels each, YouTube with the four newest
// videos. Each card: platform icon, handle, live follower count, thumbnails linking to the posts,
// and a follow button. Platform colour only on the icon chip; the rest uses the site surfaces.
import { ICON } from "../lib/icons.js";
import { followers } from "../lib/socials.js";
import { longform, shorts, CHANNEL_URL } from "../lib/youtube.js";

const yt = (longform.length ? longform : shorts).slice(0, 4);
const ytLong = longform.length > 0;
const feeds = [
  {
    key: "ig", name: "Instagram", handle: "@kiwinoygaming", icon: ICON.instagram,
    count: followers("instagram"), unit: "followers", cta: "Follow on Instagram",
    href: "https://www.instagram.com/kiwinoygaming",
    posts: [
      { href: "https://www.instagram.com/reel/DayvcPIgbjx/", img: "/social/ig1.jpg" },
      { href: "https://www.instagram.com/reel/Da9CZqMjoHR/", img: "/social/ig2.jpg" },
      { href: "https://www.instagram.com/reel/DbisHPcT4PK/", img: "/social/ig3.jpg" },
    ],
  },
  {
    key: "tt", name: "TikTok", handle: "@kiwinoygamer", icon: ICON.tiktok,
    count: followers("tiktok"), unit: "followers", cta: "Follow on TikTok",
    href: "https://www.tiktok.com/@kiwinoygamer",
    posts: [
      { href: "https://www.tiktok.com/@kiwinoygamer/video/7674212728692673812", img: "/social/tt1.jpg" },
      { href: "https://www.tiktok.com/@kiwinoygamer/video/7506479242209692946", img: "/social/tt2.jpg" },
      { href: "https://www.tiktok.com/@kiwinoygamer/video/7508511521232784658", img: "/social/tt3.jpg" },
    ],
  },
];
---
<div class="feeds">
  {feeds.map((f) => (
    <article class={`feed feed-${f.key}`} aria-label={`BOSS KG on ${f.name}`}>
      <header class="feed-h">
        <span class={`feed-ic ic-${f.key}`} set:html={f.icon}></span>
        <span class="feed-who"><b>{f.handle}</b><span>{f.name}</span></span>
        {f.count && <span class="feed-cnt"><b>{f.count}</b><span>{f.unit}</span></span>}
      </header>
      <div class="feed-thumbs v">
        {f.posts.map((p, i) => (
          <a href={p.href} target="_blank" rel="noopener" aria-label={`Watch ${f.name} post ${i + 1} from ${f.handle} (opens ${f.name})`}>
            <img src={p.img} alt="" width="360" height="640" loading="lazy" decoding="async" />
          </a>
        ))}
      </div>
      <a class="btn btn-primary feed-btn" href={f.href} target="_blank" rel="noopener">{f.cta}</a>
    </article>
  ))}
  <article class="feed feed-yt" aria-label="BOSS KG on YouTube">
    <header class="feed-h">
      <span class="feed-ic ic-yt" set:html={ICON.youtube}></span>
      <span class="feed-who"><b>Boss KG</b><span>YouTube</span></span>
      {followers("youtube") && <span class="feed-cnt"><b>{followers("youtube")}</b><span>subscribers</span></span>}
    </header>
    <div class="feed-thumbs h">
      {yt.map((v) => (
        <a href={v.slug ? `/watch/${v.slug}/` : v.url} {...(v.slug ? {} : { target: "_blank", rel: "noopener" })} aria-label={`Watch: ${v.title}`}>
          <img src={ytLong ? `https://i.ytimg.com/vi/${v.id}/mqdefault.jpg` : v.thumb} alt="" width="320" height="180" loading="lazy" decoding="async" />
        </a>
      ))}
    </div>
    <a class="btn btn-primary feed-btn" href={CHANNEL_URL} target="_blank" rel="noopener">Subscribe on YouTube</a>
  </article>
</div>
