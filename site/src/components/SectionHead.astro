---
// Section heading with the red health-bar rule and an optional "more" link.
import { ICON } from "../lib/icons.js";
interface Props { title: string; href?: string; more?: string; id?: string; ext?: boolean }
const { title, href, more, id, ext = false } = Astro.props;
---
<div class="sec-h">
  <h2 id={id}>{title}</h2>
  {href && (
    <a class="sec-more" href={href} {...(ext ? { target: "_blank", rel: "noopener" } : {})}>
      <span>{more || "See all"}</span><Fragment set:html={ICON.chevron} />
    </a>
  )}
</div>
