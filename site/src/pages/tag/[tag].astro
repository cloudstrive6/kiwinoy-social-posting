---
// Tag pages: /tag/<slug>/. Slug rule matches the tag chips on articles (lib/articles.js slugify).
import Base from "../../layouts/Base.astro";
import StoryCard from "../../components/StoryCard.astro";
import Crumbs from "../../components/Crumbs.astro";
import { liveArticles, toStory, slugify } from "../../lib/articles.js";
import { crumbsLd } from "../../lib/seo.js";

export async function getStaticPaths() {
  const map = {};
  for (const a of await liveArticles()) {
    for (const t of a.data.tags || []) {
      (map[slugify(t)] ||= { label: t, posts: [] }).posts.push(toStory(a));
    }
  }
  return Object.entries(map).map(([tag, { label, posts }]) => ({ params: { tag }, props: { label, posts } }));
}

const { label, posts } = Astro.props;
const crumbs = [{ label: "Home", href: "/" }, { label: "News", href: "/category/news/" }, { label }];
const count = `${posts.length} ${posts.length === 1 ? "story" : "stories"}`;
---
<Base title={label} description={`All BOSS KG coverage tagged ${label}: ${count}.`} jsonLd={[crumbsLd(crumbs)]}>
  <main id="main" class="wrap">
    <header class="page-head">
      <Crumbs items={crumbs.slice(0, 2)} />
      <h1>{label}</h1>
      <p class="lede">Every BOSS KG story tagged {label}, newest first. {count}.</p>
    </header>
    <div class="sec">
      <div class={`grid three${posts.length <= 3 ? " all-cards" : ""}`}>{posts.map((s) => <StoryCard s={s} h="h2" />)}</div>
    </div>
  </main>
</Base>
