---
// "Gear we use": affiliate landing page. Catalogue lives in src/lib/gear.js (shared with the home page).
// LEGAL: the disclosure paragraph (.gear-disc) and the 18+ label on LuxDrop are required. Keep them.
import Base from "../layouts/Base.astro";
import StoryCard from "../components/StoryCard.astro";
import GearTile from "../components/GearTile.astro";
import PartnerBanner from "../components/PartnerBanner.astro";
import SectionHead from "../components/SectionHead.astro";
import SectionNav from "../components/SectionNav.astro";
import { GEAR } from "../lib/gear.js";
import { liveArticles, toStory } from "../lib/articles.js";

const cats = [...new Set(GEAR.map((g) => g.cat))];
// Gear guides and reviews: any published article filed under "Hardware", newest first.
const guides = (await liveArticles()).filter((a) => /hardware/i.test(a.data.category || "")).map(toStory);
const groupTitle = { Console: "Console", Controller: "Controllers", Capture: "Capture", Audio: "Audio", Display: "Display", Storage: "Storage", Fuel: "Fuel" };
---
<Base title="Gear we use" description="The gear BOSS KG uses to record and play: controllers, capture cards, headsets and more. Affiliate links support the channel at no extra cost to you.">
  <SectionNav current="/gear/" />
  <main id="main" class="wrap">
    <header class="page-head">
      <h1>Gear we use</h1>
      <p class="lede">The kit behind the 4K/60 HDR gameplay, plus the odd thing that just makes the grind better. Everything here is stuff we would actually recommend.</p>
    </header>

    <p class="a-source gear-disc" role="note" style="margin-top:var(--s5); max-width:70ch">
      <strong>Heads up:</strong> some links below are affiliate links. If you buy through them, BOSS KG may earn a small
      commission at <strong>no extra cost to you</strong>. It is a free way to support the channel, and we only list gear we stand behind.
    </p>

    {guides.length > 0 && (
      <section class="sec" aria-labelledby="hGuides">
        <SectionHead id="hGuides" title="Guides and reviews" />
        <div class="grid three all-cards">{guides.map((s) => <StoryCard s={s} />)}</div>
      </section>
    )}

    {cats.map((c) => (
      <section class="sec" aria-labelledby={`g-${c}`}>
        <SectionHead id={`g-${c}`} title={groupTitle[c] || c} />
        <div class="gear-grid">{GEAR.filter((g) => g.cat === c).map((g) => <GearTile g={g} />)}</div>
      </section>
    ))}

    <section class="sec" aria-labelledby="hPartners">
      <SectionHead id="hPartners" title="Partner offers" />
      <div class="list" style="gap:var(--s4)">
        <PartnerBanner id="luxdrop" />
        <PartnerBanner id="trybe" />
      </div>
    </section>

    <p class="empty" style="font-size:15px; max-width:70ch">
      <strong>As an Amazon Associate I earn from qualifying purchases.</strong> Prices and availability are set by the
      retailer and can change. Product names and brands belong to their respective owners.
    </p>
  </main>
</Base>
