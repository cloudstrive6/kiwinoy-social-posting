---
// One long-form video: click-to-play facade, the blurb, related videos and stories about the game.
import Base from "../../layouts/Base.astro";
import VideoCard from "../../components/VideoCard.astro";
import StoryCard from "../../components/StoryCard.astro";
import Crumbs from "../../components/Crumbs.astro";
import NewsletterBox from "../../components/NewsletterBox.astro";
import { longform, CHANNEL_URL } from "../../lib/youtube.js";
import { gameForText, gameBySlug } from "../../lib/games.js";
import { liveArticles, toStory, fmtDate } from "../../lib/articles.js";
import { YT_PLAY, ICON } from "../../lib/icons.js";
import { crumbsLd } from "../../lib/seo.js";

export function getStaticPaths() {
  return longform.map((v) => ({ params: { slug: v.slug }, props: { v } }));
}

const { v } = Astro.props;
const gslug = gameForText(v.title);
const game = gslug ? gameBySlug(gslug) : null;
const related = longform.filter((x) => x.slug !== v.slug && gameForText(x.title) === gslug).slice(0, 4);
const stories = gslug
  ? (await liveArticles()).filter((a) => gameForText(a.data.game, a.data.category, a.data.title) === gslug).slice(0, 2).map(toStory)
  : [];
const desc = (v.blurb || `${v.title}: full gameplay from BOSS KG.`).replace(/\s+/g, " ").slice(0, 155);
const ld = {
  "@context": "https://schema.org", "@type": "VideoObject",
  name: v.title, description: v.blurb || v.title,
  thumbnailUrl: [`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`],
  uploadDate: v.published, contentUrl: v.url,
  embedUrl: `https://www.youtube.com/embed/${v.id}`,
};
const crumbs = [{ label: "Home", href: "/" }, { label: "Videos", href: "/videos/" }, ...(game ? [{ label: game.title, href: `/games/${game.slug}/` }] : []), { label: v.title }];
---
<Base title={v.title} description={desc} image={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} type="video.other" jsonLd={[ld, crumbsLd(crumbs)]}>
  <main id="main" class="wrap">
    <article class="article">
      <header class="a-head">
        <Crumbs items={crumbs.slice(0, -1)} />
        <h1>{v.title}</h1>
        <div class="a-meta">
          <span class="a-by">By KG</span>
          {v.published && <time datetime={v.published}>{fmtDate(v.published, true)}</time>}
        </div>
      </header>

      <div class="a-cover">
        <button class="vfeat" type="button" data-vid={v.id} aria-label={`Play: ${v.title}`}>
          <div class="vthumb">
            <img src={v.thumb.replace("hqdefault", "sddefault")} alt={v.title} width="640" height="480"
              loading="eager" fetchpriority="high" decoding="async"
              onerror="this.onerror=null;this.src='https://i.ytimg.com/vi/'+this.closest('[data-vid]').dataset.vid+'/hqdefault.jpg'" />
            <span class="play" set:html={YT_PLAY}></span>
          </div>
        </button>
      </div>

      <div class="prose">
        {(v.blurb || desc).split(/\n\n+/).map((p) => <p>{p}</p>)}
      </div>

      <div class="a-end">
        <div class="share">
          <a class="btn btn-primary" href={CHANNEL_URL} rel="noopener"><Fragment set:html={ICON.youtube} /><span>Subscribe to BOSS KG</span></a>
          <a class="btn btn-ghost" href={v.url} target="_blank" rel="noopener">Watch on YouTube</a>
          {game && <a class="btn btn-ghost" href={`/games/${game.slug}/`}>More {game.title}</a>}
        </div>
      </div>

      {related.length > 0 && (
        <section class="up-next" aria-labelledby="hMore" data-pagefind-ignore>
          <div class="sec-h"><h2 id="hMore">More full videos</h2></div>
          <div class="vgrid">{related.map((r) => <VideoCard v={r} />)}</div>
        </section>
      )}
      {stories.length > 0 && (
        <section class="sec" aria-labelledby="hRead" data-pagefind-ignore>
          <div class="sec-h"><h2 id="hRead">Read next</h2></div>
          <div class="grid all-cards" style="grid-template-columns:repeat(auto-fill,minmax(min(100%,280px),1fr))">{stories.map((s) => <StoryCard s={s} />)}</div>
        </section>
      )}
    </article>
    <NewsletterBox />
  </main>
</Base>
