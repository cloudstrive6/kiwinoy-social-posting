---
// Games hub: every franchise we cover, with its newest stories right under the tile.
import Base from "../../layouts/Base.astro";
import SectionNav from "../../components/SectionNav.astro";
import NewsletterBox from "../../components/NewsletterBox.astro";
import { GAMES, gameForText, gameForVideo } from "../../lib/games.js";
import { longform, shorts } from "../../lib/youtube.js";
import { liveArticles, toStory } from "../../lib/articles.js";
import { imgAttrs, SIZES } from "../../lib/img.js";

const arts = await liveArticles();
const vids = [...longform, ...shorts];
const rows = GAMES.map((g) => {
  const mine = arts.filter((a) => gameForText(a.data.game, a.data.category, a.data.title) === g.slug);
  return {
    ...g,
    stories: mine.slice(0, 2).map(toStory),
    articles: mine.length,
    videos: vids.filter((v) => gameForVideo(v) === g.slug).length,
    im: imgAttrs(g.cover, { sizes: SIZES.tile }),
  };
});
const plural = (n, w) => `${n} ${w}${n === 1 ? "" : "s"}`;
---
<Base title="Games" description="Every game BOSS KG covers: Marvel's Spider-Man, Wolverine, Final Fantasy VII, Halo and more, with the latest stories and videos for each.">
  <SectionNav current="/games/" />
  <main id="main" class="wrap">
    <header class="page-head">
      <h1>Games</h1>
      <p class="lede">The franchises we play and cover. Pick one for its news, full videos and Shorts.</p>
    </header>
    <div class="sec">
      <div class="grid three all-cards">
        {rows.map((g, i) => (
          <div class="game-tile card">
            <a class="card" href={`/games/${g.slug}/`}>
              <div class={`art ${g.art}`}>
                {g.im && <img src={g.im.src} srcset={g.im.srcset} sizes={g.im.sizes} width={g.im.width} height={g.im.height}
                  alt={`${g.title} key art`} loading={i < 3 ? "eager" : "lazy"} decoding="async" />}
              </div>
              <div class="card-body">
                <span class="game-count">{plural(g.articles, "story")}, {plural(g.videos, "video")}</span>
                <h2 class="card-title">{g.title}</h2>
                <p>{g.blurb}</p>
              </div>
            </a>
            {g.stories.length > 0 && (
              <ul class="game-links" aria-label={`Latest ${g.title} stories`}>
                {g.stories.map((s) => <li><a href={s.href}>{s.title}</a></li>)}
              </ul>
            )}
          </div>
        ))}
      </div>
    </div>
    <NewsletterBox />
  </main>
</Base>
