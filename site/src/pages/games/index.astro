---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { GAMES, gameForText } from "../../lib/games.js";
import { longform, shorts } from "../../lib/youtube.js";

const arts = await getCollection("articles", ({ data }) => !data.draft);
const vids = [...longform, ...shorts];
const rows = GAMES.map((g) => ({
  ...g,
  articles: arts.filter((a) => gameForText(a.data.game, a.data.category, a.data.title) === g.slug).length,
  videos: vids.filter((v) => gameForText(v.title) === g.slug).length,
}));
---
<Base title="Games — BOSS KG" description="Every game we cover: Marvel's Spider-Man, Wolverine, Final Fantasy VII, Halo and more.">
  <main class="wrap">
    <section class="sec" style="margin-top:34px">
      <div class="sec-h"><span class="bar"></span><h2>Games</h2><span style="margin-left:auto;color:var(--faint);font-size:13px">Pick a franchise</span></div>
      <div class="grid">
        {rows.map((g) => (
          <a class="card" href={`/games/${g.slug}`}>
            <div class={`art ${g.art}`} style="aspect-ratio:16/10; display:flex; align-items:flex-end; padding:14px">
              <span class="pill news">{g.videos} videos · {g.articles} articles</span>
            </div>
            <div class="body">
              <h3>{g.title}</h3>
              <span class="t" style="color:var(--muted); font-weight:500; -webkit-line-clamp:2; display:-webkit-box; -webkit-box-orient:vertical; overflow:hidden">{g.blurb}</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</Base>
