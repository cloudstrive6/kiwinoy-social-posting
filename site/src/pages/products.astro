---
import Base from "../layouts/Base.astro";
import { ICON } from "../lib/icons.js";

// BOSS KG digital products: OUR OWN tools, not affiliate gear (that lives on /gear/).
//
// TO ADD A PRODUCT: copy a block below. Fields:
//   name     product name                     tagline  one line under the name
//   blurb    2 or 3 sentences, what it does   points   4 to 6 short feature bullets
//   note     small print under the button (optional)
//   url      the product's own site           badge    the label at the top of the card
//   mark     logo id rendered before the name (see .mark-* in the styles below)
//
// NO PRICES ON THIS PAGE (owner, 2026-10-23): pricing lives on each product's own landing page.
const PRODUCTS = [
  {
    name: "EditTwin",
    badge: "AI video editor",
    tagline: "The AI video editor that edits like you.",
    blurb:
      "Film it, drop it in a folder, type one word. EditTwin cuts the dead air and the flubs, " +
      "writes the hook, adds captions and motion graphics, and hands back a finished MP4. It " +
      "learns how you like your edits and applies that to the next one.",
    points: [
      "Cuts silences, stumbles and false starts automatically",
      "Writes the hook, burns in captions and motion graphics",
      "Style Wizard sets captions, colours, pacing and music feel",
      "Taste Memory turns your notes into rules it follows next time",
      "Renders locally: your footage never leaves your machine",
      "9:16 or 16:9 out, Windows and Mac",
    ],
    url: "https://edittwin.bosskg.com/",
    cta: "See EditTwin",
    mark: "edittwin",
  },
];
---
<Base title="AI and automation systems" description="Tools built by BOSS KG for creators, starting with EditTwin, the AI video editor that cuts, captions and finishes your short-form video on your own machine.">
  <main id="main" class="wrap">
    <header class="page-head">
      <h1>AI and automation systems</h1>
      <p class="lede">Tools we built for the way we actually work: the same pipeline that runs this channel, packaged so you can use it too. These are our own products, not affiliate links.</p>
    </header>

    <div class="sec" style="margin-top:var(--s6)">
      {PRODUCTS.map((p) => (
        <article class="prod">
          <span class="chip">{p.badge}</span>
          <h2>{p.mark && <span class={`prod-mark mark-${p.mark}`} aria-hidden="true"></span>}{p.name}</h2>
          <p class="prod-tagline">{p.tagline}</p>
          <p class="prod-blurb">{p.blurb}</p>
          <ul class="prod-points">
            {p.points.map((pt) => <li><Fragment set:html={ICON.check} /><span>{pt}</span></li>)}
          </ul>
          <a class="btn btn-primary" href={p.url} target="_blank" rel="noopener">{p.cta}</a>
          {p.note && <p class="prod-note">{p.note}</p>}
        </article>
      ))}
    </div>

    <p class="empty" style="font-size:16px">More tools are on the way. The gear we buy and recommend lives on <a href="/gear/">Gear</a>, and you can <a href="/follow/">follow BOSS KG</a> to hear when a new tool lands.</p>
  </main>

  <style>
    .prod { max-width: 760px; display: flex; flex-direction: column; align-items: flex-start; gap: var(--s3);
      padding: var(--s6); background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-l); }
    .prod h2 { font-size: 34px; display: flex; align-items: center; gap: var(--s3); }
    .prod-tagline { font-size: 18px; font-weight: 700; color: var(--text); }
    .prod-blurb { font-family: var(--f-text); font-size: 17px; line-height: 1.6; color: var(--body); max-width: 62ch; }
    .prod-points { list-style: none; padding: 0; margin: var(--s2) 0; display: grid; gap: var(--s3); }
    .prod-points li { display: flex; gap: var(--s3); align-items: flex-start; font-size: 15px; font-weight: 600; color: var(--text); }
    .prod-points svg { flex: none; width: 18px; height: 18px; color: var(--red); margin-top: 2px; }
    .prod-note { color: var(--faint); font-size: 13px; }
    /* EditTwin's own mark (drawn in CSS on its site): coral tile with two "twin" bars. Product logo colours. */
    .prod-mark { --m: 36px; --et-coral: #FF5B3A; --et-ink: #0C0C10; --et-paper: #F4EFE6;
      flex: none; width: var(--m); height: var(--m); position: relative; overflow: hidden;
      border-radius: calc(var(--m) * .30); background: var(--et-coral); }
    .prod-mark::before, .prod-mark::after { content: ""; position: absolute; top: calc(var(--m) * .233);
      width: calc(var(--m) * .333); height: calc(var(--m) * .533); border-radius: calc(var(--m) * .133); }
    .prod-mark::before { left: calc(var(--m) * .167); background: var(--et-ink); }
    .prod-mark::after { right: calc(var(--m) * .167); background: var(--et-paper); }
    @media (max-width: 640px) { .prod { padding: var(--s5); } .prod h2 { font-size: 28px; } }
  </style>
</Base>
