---
import Base from "../layouts/Base.astro";

// BOSS KG digital products — OUR OWN tools, not affiliate gear (that lives on /gear).
//
// TO ADD A PRODUCT: copy a block below. Fields:
//   name     product name                     tagline  one line under the name
//   blurb    2-3 sentences, what it DOES      points   4-6 short feature bullets
//   note     small print under the button (requirements, guarantees) — optional
//   url      the product's own site           badge    the pill at the top of the card
//   mark     logo id rendered before the name (see .mark-* in the styles below)
//   img      optional cover image in /public (e.g. "/products/edittwin.jpg")
//
// NO PRICES ON THIS PAGE (user, 2026-10-23): pricing lives on each product's own landing
// page, where it can change without a site rebuild and without going stale here.
const PRODUCTS = [
  {
    name: "EditTwin",
    badge: "AI Video Editor",
    tagline: "The AI video editor that edits like you.",
    blurb:
      "Film it, drop it in a folder, type one word. EditTwin cuts the dead air and the flubs, " +
      "writes the hook, adds captions and motion graphics, and hands back a finished MP4. It " +
      "learns how you like your edits and applies that to the next one.",
    points: [
      "Cuts silences, stumbles and false starts automatically",
      "Writes the hook, burns in captions and motion graphics",
      "Style Wizard sets captions, colours, pacing and music feel",
      "Taste Memory turns your notes into rules it follows next time",
      "Renders locally — your footage never leaves your machine",
      "9:16 or 16:9 out, Windows and Mac",
    ],
    url: "https://edittwin.bosskg.com/",
    cta: "See EditTwin",
    mark: "edittwin",
    img: "",
  },
];
---

<Base
  title="AI & Automation Systems — BOSS KG"
  description="Tools built by BOSS KG for creators — starting with EditTwin, the AI video editor that cuts, captions and finishes your short-form video on your own machine."
>
  <main class="wrap">
    <section class="sec" style="margin-top:34px">
      <div class="sec-h"><span class="bar"></span><h2>AI &amp; Automation Systems</h2></div>
      <p class="lede">
        Tools we built for the way we actually work — the same pipeline that runs this channel,
        packaged so you can use it too. These are <strong>our own products</strong>, not affiliate
        links. (The gear we buy and recommend lives on <a href="/gear">Gear</a>.)
      </p>

      <div class="prod-grid">
        {PRODUCTS.map((p) => (
          <article class="prod-card">
            {p.img && (
              <div class="prod-img"><img src={p.img} alt={p.name} loading="lazy" /></div>
            )}
            <span class="prod-badge">{p.badge}</span>
            <h3>
              {p.mark && <span class={`prod-mark mark-${p.mark}`} aria-hidden="true"></span>}
              {p.name}
            </h3>
            <p class="prod-tagline">{p.tagline}</p>
            <p class="prod-blurb">{p.blurb}</p>

            <ul class="prod-points">
              {p.points.map((pt) => <li>{pt}</li>)}
            </ul>

            <div class="prod-buy">
              <a class="prod-btn" href={p.url} target="_blank" rel="noopener">{p.cta} →</a>
            </div>

            {p.note && <p class="prod-note">{p.note}</p>}
          </article>
        ))}
      </div>

      <p class="prod-foot">
        More tools are on the way. Want to hear when one lands?
        <a href="/follow">Follow BOSS KG</a>.
      </p>
    </section>
  </main>

  <style>
    .lede { color: var(--muted); margin: 10px 0 0; max-width: 68ch; line-height: 1.6; }
    .lede a { color: var(--red); font-weight: 700; }

    .prod-grid {
      display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; margin-top: 22px;
    }
    /* A single product shouldn't sit in a half-width column looking unfinished. */
    .prod-grid:has(> :only-child) { grid-template-columns: 1fr; }
    .prod-grid:has(> :only-child) .prod-card { max-width: 760px; }

    .prod-card {
      background: var(--surface); border: 1px solid var(--border); border-radius: 16px;
      padding: 22px; display: flex; flex-direction: column; gap: 10px; transition: .16s;
    }
    .prod-card:hover {
      transform: translateY(-3px); box-shadow: var(--shadow);
      border-color: color-mix(in srgb, var(--red) 40%, var(--border));
    }
    .prod-img {
      background: #fff; border-radius: 12px; overflow: hidden; margin-bottom: 4px;
      display: flex; align-items: center; justify-content: center;
    }
    .prod-img img { display: block; width: 100%; height: auto; }
    .prod-badge {
      align-self: flex-start; font-size: 11px; font-weight: 800; letter-spacing: .09em;
      text-transform: uppercase; color: var(--red);
      background: color-mix(in srgb, var(--red) 14%, transparent);
      padding: 3px 9px; border-radius: 999px;
    }
    .prod-card h3 {
      font-size: 26px; margin: 2px 0 0; line-height: 1.15;
      display: flex; align-items: center; gap: 10px;
    }

    /* Product logo marks. EditTwin's logo is drawn in CSS on its own site rather than
       served as an image file, so it is reproduced here from the same rules (coral tile,
       two "twin" bars — one ink, one paper) scaled to this heading. --m drives every
       dimension, so the proportions hold at any size. */
    .prod-mark { flex: none; width: var(--m); height: var(--m); position: relative; overflow: hidden; }
    .mark-edittwin {
      --m: 34px;
      border-radius: calc(var(--m) * .30);
      background: #FF5B3A;
    }
    .mark-edittwin::before, .mark-edittwin::after {
      content: ""; position: absolute;
      top: calc(var(--m) * .233);
      width: calc(var(--m) * .333);
      height: calc(var(--m) * .533);
      border-radius: calc(var(--m) * .133);
    }
    .mark-edittwin::before { left: calc(var(--m) * .167); background: #0C0C10; }
    .mark-edittwin::after { right: calc(var(--m) * .167); background: #F4EFE6; }
    .prod-tagline { color: var(--text); font-size: 16px; font-weight: 700; margin: 0; }
    .prod-blurb { color: var(--muted); font-size: 14.5px; line-height: 1.6; margin: 0; max-width: 62ch; }

    .prod-points { list-style: none; padding: 0; margin: 4px 0 0; display: grid; gap: 7px; }
    .prod-points li {
      color: var(--text); font-size: 14px; line-height: 1.45;
      padding-left: 22px; position: relative;
    }
    .prod-points li::before {
      content: "✓"; position: absolute; left: 0; top: 0;
      color: var(--red); font-weight: 900; font-size: 13px;
    }

    .prod-buy { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-top: 12px; }
    .prod-btn {
      font-weight: 800; font-size: 15px; text-decoration: none; padding: 12px 20px;
      border-radius: 11px; background: var(--red); color: #fff; transition: .16s;
    }
    .prod-btn:hover { filter: brightness(1.08); }
    .prod-note { color: var(--faint); font-size: 12.5px; line-height: 1.5; margin: 2px 0 0; max-width: 60ch; }

    .prod-foot { color: var(--muted); font-size: 14px; margin-top: 34px; }
    .prod-foot a { color: var(--red); font-weight: 700; }

    @media (max-width: 860px) { .prod-grid { grid-template-columns: 1fr; } }
  </style>
</Base>
