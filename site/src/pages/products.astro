---
import Base from "../layouts/Base.astro";
import { ICON } from "../lib/icons.js";

// BOSS KG digital products: OUR OWN tools, not affiliate gear (that lives on /gear/).
//
// TO ADD A PRODUCT: copy a block below. Fields:
//   name     product name                     tagline  one line under the name
//   blurb    2 or 3 sentences, what it does   points   4 to 6 short feature bullets
//   note     small print beside the button (optional)
//   url      the product's own site           badge    the label at the top of the card
//   mark     logo id rendered before the name (see .mark-* in the styles below)
//   shot     product image (1200x630 share card in /products/, with a 640 px variant)
//
// NO PRICES ON THIS PAGE (owner, 2026-10-23): pricing lives on each product's own landing page.
// Layout rebuilt 2026-11-12 (owner: "looks hideous"): the check icons were unstyled (scoped CSS
// cannot reach set:html SVGs) and rendered ~150 px tall. Now a two-column feature card with the
// product's own image, and the points as a grid of small checked items.
const PRODUCTS = [
  {
    name: "EditTwin",
    badge: "AI video editor",
    tagline: "The AI video editor that edits like you.",
    blurb:
      "Film it, drop it in a folder, type one word. EditTwin cuts the dead air and the flubs, " +
      "writes the hook, adds captions and motion graphics, and hands back a finished MP4. It " +
      "learns how you like your edits and applies that to the next one.",
    points: [
      "Cuts silences, stumbles and false starts automatically",
      "Writes the hook, burns in captions and motion graphics",
      "Style Wizard sets captions, colours, pacing and music feel",
      "Taste Memory turns your notes into rules it follows next time",
      "Renders locally: your footage never leaves your machine",
      "9:16 or 16:9 out, Windows and Mac",
    ],
    url: "https://edittwin.bosskg.com/",
    cta: "See EditTwin",
    note: "Runs on Windows and Mac",
    mark: "edittwin",
    shot: { src: "/products/edittwin-1200.webp", srcset: "/products/edittwin-640.webp 640w, /products/edittwin-1200.webp 1200w",
            alt: "EditTwin: film it, drop it in, get back a reel that looks like you made it" },
  },
];
---
<Base title="AI and automation systems" description="Tools built by BOSS KG for creators, starting with EditTwin, the AI video editor that cuts, captions and finishes your short-form video on your own machine.">
  <main id="main" class="wrap">
    <header class="page-head">
      <h1>AI and automation systems</h1>
      <p class="lede">Tools we built for the way we actually work: the same pipeline that runs this channel, packaged so you can use it too. These are our own products, not affiliate links.</p>
    </header>

    <div class="sec" style="margin-top:var(--s6)">
      {PRODUCTS.map((p, i) => (
        <article class="prod" aria-labelledby={`prod-${i}`}>
          <div class="prod-top">
            <div class="prod-copy">
              <span class="chip">{p.badge}</span>
              <h2 id={`prod-${i}`}>{p.mark && <span class={`prod-mark mark-${p.mark}`} aria-hidden="true"></span>}{p.name}</h2>
              <p class="prod-tagline">{p.tagline}</p>
              <p class="prod-blurb">{p.blurb}</p>
              <div class="prod-cta">
                <a class="btn btn-primary" href={p.url} target="_blank" rel="noopener">{p.cta}<Fragment set:html={ICON.chevron} /></a>
                {p.note && <span class="prod-note">{p.note}</span>}
              </div>
            </div>
            {p.shot && (
              <a class="prod-shot" href={p.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
                <img src={p.shot.src} srcset={p.shot.srcset} sizes="(min-width: 1024px) 560px, 92vw" alt="" width="1200" height="630" loading={i === 0 ? "eager" : "lazy"} decoding="async" />
              </a>
            )}
          </div>
          <ul class="prod-points" aria-label={`What ${p.name} does`}>
            {p.points.map((pt) => <li><span class="prod-tick" set:html={ICON.check}></span><span>{pt}</span></li>)}
          </ul>
        </article>
      ))}
    </div>

    <p class="prod-more">More tools are on the way. The gear we buy and recommend lives on <a href="/gear/">Gear</a>, and you can <a href="/follow/">follow BOSS KG</a> to hear when a new tool lands.</p>
  </main>

  <style>
    .prod { padding: var(--s6); background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-l);
      display: grid; gap: var(--s6); }
    .prod-top { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: var(--s6); align-items: center; }
    .prod-copy { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s3); min-width: 0; }
    .prod h2 { font-size: 40px; line-height: 1.05; display: flex; align-items: center; gap: var(--s3); margin: 0; }
    .prod-tagline { font-size: 20px; font-weight: 700; color: var(--text); margin: 0; }
    .prod-blurb { font-family: var(--f-text); font-size: 17px; line-height: 1.6; color: var(--body); max-width: 34em; margin: 0; }
    .prod-cta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s3) var(--s4); margin-top: var(--s2); }
    .prod-note { color: var(--muted); font-size: 14px; }
    .prod-shot { display: block; border-radius: var(--r-l); overflow: hidden; border: 1px solid var(--border-2);
      box-shadow: 0 24px 60px -24px rgba(0, 0, 0, .7); aspect-ratio: 1200 / 630; background: var(--raise); }
    .prod-shot img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform var(--d-hover) var(--ease-out); }
    @media (hover: hover) and (pointer: fine) { .prod-shot:hover img { transform: scale(1.02); } }
    .prod-points { list-style: none; padding: var(--s5) 0 0; margin: 0; border-top: 1px solid var(--border);
      display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s4) var(--s5); }
    .prod-points li { display: flex; gap: var(--s3); align-items: flex-start; font-size: 15px; line-height: 1.45; font-weight: 600; color: var(--text); }
    .prod-tick { flex: none; width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center;
      background: var(--red-tint); color: var(--red); margin-top: -1px; }
    /* set:html SVGs are outside Astro's scope, so size them with :global (the old page missed this). */
    .prod-tick :global(svg) { width: 14px; height: 14px; }
    .prod-cta :global(svg) { width: 16px; height: 16px; }
    .prod-more { margin-top: var(--s6); font-family: var(--f-text); font-size: 16px; color: var(--muted); }
    .prod-more a { color: var(--text); text-decoration: underline; text-decoration-color: var(--red); text-underline-offset: 3px; }
    /* EditTwin's own mark (drawn in CSS on its site): coral tile with two "twin" bars. Product logo colours. */
    .prod-mark { --m: 40px; --et-coral: #FF5B3A; --et-ink: #0C0C10; --et-paper: #F4EFE6;
      flex: none; width: var(--m); height: var(--m); position: relative; overflow: hidden;
      border-radius: calc(var(--m) * .30); background: var(--et-coral); }
    .prod-mark::before, .prod-mark::after { content: ""; position: absolute; top: calc(var(--m) * .233);
      width: calc(var(--m) * .333); height: calc(var(--m) * .533); border-radius: calc(var(--m) * .133); }
    .prod-mark::before { left: calc(var(--m) * .167); background: var(--et-ink); }
    .prod-mark::after { right: calc(var(--m) * .167); background: var(--et-paper); }
    @media (max-width: 1023px) {
      .prod-top { grid-template-columns: minmax(0, 1fr); }
      .prod-shot { order: -1; }
      .prod-points { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 640px) {
      .prod { padding: var(--s5); gap: var(--s5); }
      .prod h2 { font-size: 32px; }
      .prod-mark { --m: 34px; }
      .prod-points { grid-template-columns: minmax(0, 1fr); }
      .prod-cta, .prod-cta .btn { width: 100%; }
    }
    @media (prefers-reduced-motion: reduce) { .prod-shot img { transition: none; } }
  </style>
</Base>
