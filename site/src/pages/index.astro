---
// Home: lead story (the featured trend, else the newest; site_featured.py logic unchanged) with a
// side rail, then sectioned rails (Marvel games, MCU, Shorts, gaming, videos, gear), one partner
// offer at a time between them, and Latest as a compact list.
import Base from "../layouts/Base.astro";
import StoryCard from "../components/StoryCard.astro";
import SectionHead from "../components/SectionHead.astro";
import SectionNav from "../components/SectionNav.astro";
import NewsletterBox from "../components/NewsletterBox.astro";
import VideoCard from "../components/VideoCard.astro";
import PartnerBanner from "../components/PartnerBanner.astro";
import GearTile from "../components/GearTile.astro";
import { liveArticles, toStory, SECTIONS, sectionFor } from "../lib/articles.js";
import { imgAttrs, SIZES } from "../lib/img.js";
import { longform, shorts, CHANNEL_URL } from "../lib/youtube.js";
import { followers } from "../lib/socials.js";
import { GEAR } from "../lib/gear.js";
import { ICON } from "../lib/icons.js";
import { ORG, SITE } from "../lib/seo.js";

const all = await liveArticles();
const leadEntry = all.find((a) => a.data.featured) ?? all[0];
const used = new Set(leadEntry ? [leadEntry.id] : []);
const take = (list, n) => {
  const out = [];
  for (const a of list) {
    if (out.length >= n) break;
    if (used.has(a.id)) continue;
    used.add(a.id);
    out.push(toStory(a));
  }
  return out;
};
const side = take(all, 4);
const marvel = take(all.filter((a) => SECTIONS["marvel-games"].match(a.data)), 4);
const mcu = take(all.filter((a) => SECTIONS.mcu.match(a.data)), 4);
const gaming = take(all.filter((a) => !SECTIONS["marvel-games"].match(a.data) && !SECTIONS.mcu.match(a.data)), 6);
const latest = take(all, 6);

const lead = leadEntry ? toStory(leadEntry) : null;
const leadImg = lead ? imgAttrs(lead.cover, { sizes: SIZES.lead }) : null;

const vids = longform.slice(0, 4);
const shortList = shorts.slice(0, 8);
const gearPicks = ["PlayStation 5 Pro (2TB)", "DualSense Edge", "Elgato 4K Pro (internal)", "DUBBY Energy"]
  .map((n) => GEAR.find((g) => g.name === n)).filter(Boolean);
const soc = [
  { name: "YouTube", handle: "Boss KG", href: CHANNEL_URL, icon: ICON.youtube, count: followers("youtube"), unit: "subscribers" },
  { name: "TikTok", handle: "@kiwinoygamer", href: "https://www.tiktok.com/@kiwinoygamer", icon: ICON.tiktok, count: followers("tiktok"), unit: "followers" },
  { name: "Instagram", handle: "@kiwinoygaming", href: "https://www.instagram.com/kiwinoygaming", icon: ICON.instagram, count: followers("instagram"), unit: "followers" },
];
const ld = [
  { "@context": "https://schema.org", ...ORG },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "BOSS KG",
    url: `${SITE}/`,
    publisher: { "@id": `${SITE}/#org` },
    potentialAction: {
      "@type": "SearchAction",
      target: { "@type": "EntryPoint", urlTemplate: `${SITE}/search/?q={search_term_string}` },
      "query-input": "required name=search_term_string",
    },
  },
];
---
<Base jsonLd={ld} preloadImage={leadImg && leadImg.srcset ? { srcset: leadImg.srcset, sizes: leadImg.sizes } : undefined}>
  <SectionNav />
  <main id="main" class="wrap">
    <h1 class="sr-only">BOSS KG: gaming and Marvel news</h1>

    {lead && (
      <section class="hero" aria-label="Top stories">
        <a class="lead" href={lead.href}>
          <div class={`art ${lead.gclass}`}>
            {leadImg && (
              <img src={leadImg.src} srcset={leadImg.srcset} sizes={leadImg.sizes} width={leadImg.width} height={leadImg.height}
                alt={lead.coverAlt} loading="eager" fetchpriority="high" decoding="async" />
            )}
          </div>
          <div class="lead-body">
            <span class="kick"><span class="chip">{lead.cat}</span>{lead.tag !== "News" && <span class={`flag${lead.tag === "Hot" ? " hot" : ""}`}>{lead.tag}</span>}</span>
            <h2>{lead.title}</h2>
            <p class="lead-dek">{lead.excerpt}</p>
            <p class="lead-meta">By KG, <time datetime={lead.date}>{lead.dateLabel}</time></p>
          </div>
        </a>
        <div class="side">
          <p class="side-h">More top stories</p>
          {side.map((s) => <StoryCard s={s} variant="row" />)}
        </div>
      </section>
    )}

    {marvel.length > 1 && (
      <section class="sec" aria-labelledby="hMarvel">
        <SectionHead id="hMarvel" title="Marvel games" href="/category/marvel-games/" more="All Marvel games" ruled />
        <div class="rail-lead">
          <StoryCard s={marvel[0]} variant="big" />
          <div class="list">{marvel.slice(1).map((s) => <StoryCard s={s} variant="row" />)}</div>
        </div>
      </section>
    )}

    <div class="sec"><PartnerBanner id="luxdrop" /></div>

    {mcu.length > 1 && (
      <section class="sec" aria-labelledby="hMcu">
        <SectionHead id="hMcu" title="MCU" href="/category/mcu/" more="All MCU" />
        <div class="grid">{mcu.map((s) => <StoryCard s={s} />)}</div>
      </section>
    )}

    {shortList.length > 0 && (
      <section class="sec" aria-labelledby="hShorts">
        <SectionHead id="hShorts" title="Shorts" href="/videos/" more="All videos" />
        <div class="srail">{shortList.map((v) => <VideoCard v={v} short />)}</div>
      </section>
    )}

    {gaming.length > 1 && (
      <section class="sec" aria-labelledby="hGaming">
        <SectionHead id="hGaming" title="Gaming and PlayStation" href="/category/news/" more="All news" />
        <ol class="numbered">
          {gaming.map((s) => (
            <li><a href={s.href}><span class="n-body"><span class="chip">{s.cat}</span><h3 class="card-title">{s.title}</h3><time class="card-date" datetime={s.date}>{s.dateLabel}</time></span></a></li>
          ))}
        </ol>
      </section>
    )}

    <NewsletterBox formId="sub-form" />

    {vids.length > 0 && (
      <section class="sec" aria-labelledby="hVideos">
        <SectionHead id="hVideos" title="Latest full videos" href="/videos/" more="All videos" />
        <div class="vgrid">{vids.map((v) => <VideoCard v={v} showDate />)}</div>
      </section>
    )}

    {gearPicks.length > 0 && (
      <section class="sec" aria-labelledby="hGear">
        <SectionHead id="hGear" title="Gear we use" href="/gear/" more="All gear" />
        <div class="gear-grid compact no-notes">{gearPicks.map((g) => <GearTile g={g} />)}</div>
        <div style="margin-top:var(--s5)"><PartnerBanner id="trybe" /></div>
      </section>
    )}

    {latest.length > 0 && (
      <section class="sec" aria-labelledby="hLatest">
        <SectionHead id="hLatest" title="Latest" href="/category/news/" more="All news" />
        <div class="list cols">{latest.map((s) => <StoryCard s={s} variant="row" />)}</div>
      </section>
    )}

    <section class="sec" aria-labelledby="hFollow">
      <SectionHead id="hFollow" title="Follow BOSS KG" href="/follow/" more="Every channel" />
      <div class="follow-row">
        {soc.map((s) => (
          <a class="soc-tile" href={s.href} rel="noopener">
            <span class="soc-ic" set:html={s.icon}></span>
            <span>
              <span class="soc-name">{s.name}</span><br />
              <span class="soc-handle">{s.handle}{s.count && <>, <span class="soc-count">{s.count}</span> {s.unit}</>}</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  </main>
</Base>
