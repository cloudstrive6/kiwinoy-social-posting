  twitch: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 2 3 6.5V19h4v3h2.5l3-3H17l5-5V2H4Zm16 11-3 3h-4l-3 3v-3H6.5V4H20v9Z"/><path d="M15.5 7.5H17.5V12H15.5zM10.5 7.5H12.5V12H10.5z"/></svg>`,
  kick: `<b>K</b>`,
  trovo: `<b>T</b>`,
  discord: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.5 5.3A16.9 16.9 0 0 0 15.3 4l-.2.4a15.7 15.7 0 0 1 3.7 1.2 15.4 15.4 0 0 0-13.6 0A15.7 15.7 0 0 1 8.9 4.4L8.7 4a16.9 16.9 0 0 0-4.2 1.3C1.8 9.3 1.1 13.2 1.4 17a17 17 0 0 0 5.2 2.6l.6-1a11 11 0 0 1-1.8-.9l.4-.3a11.9 11.9 0 0 0 10.4 0l.4.3a11 11 0 0 1-1.8.9l.6 1a17 17 0 0 0 5.2-2.6c.4-4.5-.6-8.4-2.6-11.7ZM8.9 14.7c-1 0-1.8-.9-1.8-2.1 0-1.1.8-2.1 1.8-2.1s1.8 1 1.8 2.1c0 1.2-.8 2.1-1.8 2.1Zm6.2 0c-1 0-1.8-.9-1.8-2.1 0-1.1.8-2.1 1.8-2.1s1.8 1 1.8 2.1c0 1.2-.8 2.1-1.8 2.1Z"/></svg>`,
  threads: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.19 24h-.01c-3.58-.02-6.34-1.2-8.18-3.51C2.35 18.44 1.5 15.59 1.47 12.01v-.02c.03-3.58.88-6.43 2.53-8.48C5.85 1.2 8.6.02 12.18 0h.01c2.75.02 5.05.73 6.83 2.1 1.68 1.29 2.86 3.13 3.51 5.47l-2.04.57c-1.1-3.96-3.9-5.99-8.3-6.02-2.91.02-5.11.94-6.54 2.72C4.31 6.5 3.62 8.91 3.59 12c.03 3.09.72 5.5 2.06 7.16 1.43 1.78 3.63 2.7 6.54 2.72 2.62-.02 4.36-.63 5.8-2.05 1.65-1.61 1.62-3.59 1.09-4.8-.31-.71-.87-1.3-1.63-1.75-.19 1.35-.62 2.45-1.28 3.27-.89 1.1-2.14 1.7-3.73 1.79-1.2.07-2.36-.22-3.26-.8-1.06-.69-1.69-1.74-1.75-2.96-.07-1.19.41-2.29 1.33-3.08.88-.76 2.12-1.21 3.58-1.29 1.07-.06 2.08-.01 3.02.14-.13-.74-.38-1.33-.75-1.76-.51-.59-1.31-.88-2.36-.89h-.03c-.84 0-1.99.23-2.72 1.32L7.73 7.85c.98-1.45 2.57-2.26 4.48-2.26h.04c3.19.02 5.1 1.98 5.29 5.39.11.05.22.09.32.14 1.5.71 2.6 1.78 3.18 3.1.8 1.84.88 4.83-1.55 7.21-1.85 1.81-4.09 2.63-7.28 2.65Zm1.04-10.67c-.17 0-.35 0-.52.01-1.69.1-2.74.88-2.69 1.76.05.9 1.03 1.31 1.98 1.26 1.69-.09 2.73-1.24 2.73-3.01-.48-.1-.98-.02-1.5-.02Z"/></svg>`,
};
const socials = [
  { key: "youtube", name: "YouTube", handle: "Boss KG · @Kiwinoy", url: "https://www.youtube.com/@Kiwinoy", pc: "#FF0000", ink: "#fff", cta: "Subscribe" },
  { key: "facebook", name: "Facebook", handle: "Boss KG", url: "https://www.facebook.com/KiwinoyGaming", pc: "#1877F2", ink: "#fff" },
  { key: "tiktok", name: "TikTok", handle: "@kiwinoygamer", url: "https://www.tiktok.com/@kiwinoygamer", pc: "#111", ink: "#fff" },
  { key: "instagram", name: "Instagram", handle: "@kiwinoygaming", url: "https://www.instagram.com/kiwinoygaming", pc: "#E1306C", ink: "#fff" },
  { key: "twitch", name: "Twitch", handle: "kiwinoy", url: "https://www.twitch.tv/kiwinoy", pc: "#9146FF", ink: "#fff" },
  { key: "kick", name: "Kick", handle: "kiwinoy", url: "https://kick.com/kiwinoy", pc: "#53FC18", ink: "#0F1116" },
  { key: "trovo", name: "Trovo", handle: "Kiwinoy", url: "https://trovo.live/s/Kiwinoy", pc: "#19D66B", ink: "#0F1116" },
  { key: "threads", name: "Threads", handle: "@kiwinoygaming", url: "https://www.threads.com/@kiwinoygaming", pc: "#000000", ink: "#fff" },
  { key: "discord", name: "Discord", handle: "KG Crew", url: "https://discord.gg/JxJ7ZYnXM", pc: "#5865F2", ink: "#fff", cta: "Join" },
];
---
<Base title="Follow — BOSS KG" description="Follow Boss KG on YouTube, Twitch, Kick, Facebook, TikTok, Instagram and Trovo for gameplay, streams, clips and the daily drop.">
  <main class="wrap">
    <section class="follow" style="margin-top:34px" aria-label="Follow us on social">
      <div class="follow-top">
        <span class="bar" style="width:4px;height:26px;background:var(--red);border-radius:3px"></span>
        <div><h2>Follow the action</h2><p>Gameplay, live streams, clips and the daily drop — hit follow so you never miss a moment.</p></div>
      </div>
      <div class="soc-grid2">
        {socials.map((s) => (
          <a class="soc-card" href={s.url} rel="noopener" style={`--pc:${s.pc}; --ink:${s.ink}`} aria-label={`Boss KG on ${s.name}`}>
            <div class="soc-av">
              <img src="/avatar.jpg" alt="Boss KG" loading="lazy"
                   onerror="this.onerror=null;this.src='/avatar.svg'" />
              <span class="soc-badge" set:html={IC[s.key]}></span>
            </div>
            <div class="nm">{s.name}</div>
            <div class="hd">{s.handle}</div>
            <span class="soc-follow">{s.cta || "Follow"}</span>
          </a>
        ))}
      </div>
    </section>

  </main>
</Base>
