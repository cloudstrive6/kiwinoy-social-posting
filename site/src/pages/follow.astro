---
// Every live BOSS KG channel, in the site's own surface system (platform colour only on the icon).
import Base from "../layouts/Base.astro";
import NewsletterBox from "../components/NewsletterBox.astro";
import SectionHead from "../components/SectionHead.astro";
import SocialFeeds from "../components/SocialFeeds.astro";
import { ICON } from "../lib/icons.js";
import { followers } from "../lib/socials.js";

const letter = (l) => `<b aria-hidden="true">${l}</b>`;
const socials = [
  { key: "youtube", name: "YouTube", handle: "Boss KG, @Kiwinoy", url: "https://www.youtube.com/@Kiwinoy", icon: ICON.youtube, count: followers("youtube"), unit: "subscribers" },
  { key: "tiktok", name: "TikTok", handle: "@kiwinoygamer", url: "https://www.tiktok.com/@kiwinoygamer", icon: ICON.tiktok, count: followers("tiktok"), unit: "followers" },
  { key: "instagram", name: "Instagram", handle: "@kiwinoygaming", url: "https://www.instagram.com/kiwinoygaming", icon: ICON.instagram, count: followers("instagram"), unit: "followers" },
  { key: "facebook", name: "Facebook", handle: "Boss KG", url: "https://www.facebook.com/KiwinoyGaming", icon: ICON.facebook },
  { key: "twitch", name: "Twitch", handle: "kiwinoy", url: "https://www.twitch.tv/kiwinoy", icon: ICON.twitch },
  { key: "kick", name: "Kick", handle: "kiwinoy", url: "https://kick.com/kiwinoy", icon: letter("K") },
  { key: "trovo", name: "Trovo", handle: "Kiwinoy", url: "https://trovo.live/s/Kiwinoy", icon: letter("T") },
  { key: "threads", name: "Threads", handle: "@kiwinoygaming", url: "https://www.threads.com/@kiwinoygaming", icon: ICON.threads },
  { key: "discord", name: "Discord", handle: "KG Crew server", url: "https://discord.gg/JxJ7ZYnXM", icon: ICON.discord },
];
---
<Base title="Follow" description="Follow BOSS KG on YouTube, Twitch, Kick, Facebook, TikTok, Instagram and Trovo for gameplay, streams, clips and the daily drop.">
  <main id="main" class="wrap">
    <header class="page-head">
      <h1>Follow BOSS KG</h1>
      <p class="lede">Gameplay, live streams, clips and the daily drop. Pick your platform and hit follow so you never miss a moment.</p>
    </header>
    <section class="sec" style="margin-top:var(--s6)" aria-labelledby="hLatestSoc">
      <SectionHead id="hLatestSoc" title="Latest from our channels" />
      <SocialFeeds />
    </section>
    <section class="sec" aria-labelledby="hEvery">
      <SectionHead id="hEvery" title="Every channel" />
      <div class="follow-row follow-all">
        {socials.map((s) => (
          <a class="soc-tile" href={s.url} rel="noopener" aria-label={`BOSS KG on ${s.name}`}>
            <span class="soc-ic" set:html={s.icon}></span>
            <span>
              <span class="soc-name">{s.name}</span><br />
              <span class="soc-handle">{s.handle}{s.count && <>, <span class="soc-count">{s.count}</span> {s.unit}</>}</span>
            </span>
          </a>
        ))}
      </div>
    </section>
    <NewsletterBox />
  </main>
</Base>
