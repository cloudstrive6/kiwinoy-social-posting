---
// Videos: the newest full video as a feature row (sharp 1280 px still, title and actions beside it
// on desktop), then the library with two large cards first, 12 videos up front and the rest behind
// "Show more" (native <details>, no JS), then Shorts (click to play in place).
import Base from "../layouts/Base.astro";
import VideoCard from "../components/VideoCard.astro";
import SectionHead from "../components/SectionHead.astro";
import SectionNav from "../components/SectionNav.astro";
import NewsletterBox from "../components/NewsletterBox.astro";
import { longform, shorts, CHANNEL_URL } from "../lib/youtube.js";
import { fmtDate } from "../lib/articles.js";
import { YT_PLAY, ICON } from "../lib/icons.js";

const feat = longform[0];
const restLong = longform.slice(1);
const upFront = restLong.slice(0, 12);
const later = restLong.slice(12);
const gridShorts = shorts.slice(0, 12);
const has = longform.length > 0 || shorts.length > 0;
const yt = (id, f) => `https://i.ytimg.com/vi/${id}/${f}.jpg`;
// Same-origin WebP copies of the 1280 px still, written at build time by integrations/image-variants.mjs.
// If they are missing, the onerror handler falls back to YouTube's own hq720 image.
const featSrcset = feat ? [480, 800, 1280].map((w) => `/img/yt/${feat.id}-${w}.webp ${w}w`).join(", ") : "";
const featSizes = "(min-width: 1024px) 760px, calc(100vw - 40px)";
const blurb = feat && feat.blurb ? feat.blurb.replace(/\s+/g, " ").split(/(?<=[.!?])\s/).slice(0, 2).join(" ") : "";
---
<Base title="Videos" description="4K 60fps HDR gameplay, full walkthroughs and Shorts from BOSS KG."
  preloadImage={feat ? { srcset: featSrcset, sizes: featSizes } : undefined}>
  <SectionNav current="/videos/" />
  <main id="main" class="wrap">
    <header class="page-head">
      <h1>Videos</h1>
      <p class="lede">Full 4K 60fps HDR playthroughs and quick Shorts from the BOSS KG channel.</p>
    </header>

    {!has && (
      <p class="empty">New videos are on the way. <a href={CHANNEL_URL} rel="noopener">Watch on YouTube</a>.</p>
    )}

    {feat && (
      <section class="vfeat-row" aria-labelledby="hFeat">
        <a class="vfeat" href={`/watch/${feat.slug}/`} aria-hidden="true" tabindex="-1">
          <div class="vthumb">
            <img src={`/img/yt/${feat.id}-800.webp`} srcset={featSrcset} sizes={featSizes} alt="" width="1280" height="720"
              loading="eager" fetchpriority="high" decoding="async"
              onerror={`this.onerror=null;this.removeAttribute('srcset');this.src='${yt(feat.id, "hq720")}'`} />
            <span class="play" set:html={YT_PLAY}></span>
          </div>
        </a>
        <div class="vfeat-text">
          <span class="chip">Latest full video</span>
          <h2 id="hFeat"><a href={`/watch/${feat.slug}/`}>{feat.title}</a></h2>
          {feat.published && <p class="card-date">{fmtDate(feat.published, true)}</p>}
          {blurb && <p>{blurb}</p>}
          <div class="vfeat-actions">
            <a class="btn btn-primary" href={`/watch/${feat.slug}/`}><Fragment set:html={ICON.youtube} /><span>Watch now</span></a>
            <a class="btn btn-ghost" href={CHANNEL_URL} rel="noopener">Subscribe</a>
          </div>
        </div>
      </section>
    )}

    {upFront.length > 0 && (
      <section class="sec" aria-labelledby="hFull">
        <SectionHead id="hFull" title="Full videos" href={CHANNEL_URL} more="YouTube channel" ext />
        <div class="vgrid mixed">{upFront.map((v, i) => <VideoCard v={v} showDate big={i < 2} />)}</div>
        {later.length > 0 && (
          <details class="more-videos">
            <summary class="btn btn-ghost">Show {later.length} more videos</summary>
            <div class="vgrid">{later.map((v) => <VideoCard v={v} showDate />)}</div>
          </details>
        )}
      </section>
    )}

    {gridShorts.length > 0 && (
      <section class="sec" aria-labelledby="hShorts">
        <SectionHead id="hShorts" title="Shorts" href={`${CHANNEL_URL}/shorts`} more="More on YouTube" ext />
        <div class="sgrid">{gridShorts.map((v) => <VideoCard v={v} short />)}</div>
      </section>
    )}

    <NewsletterBox />
  </main>
</Base>
