---
// Videos: the newest full video as a feature, the rest of the long-form library, then Shorts
// (click to play in place through the facade in Base.astro).
import Base from "../layouts/Base.astro";
import VideoCard from "../components/VideoCard.astro";
import SectionHead from "../components/SectionHead.astro";
import SectionNav from "../components/SectionNav.astro";
import NewsletterBox from "../components/NewsletterBox.astro";
import { longform, shorts, CHANNEL_URL } from "../lib/youtube.js";
import { fmtDate } from "../lib/articles.js";
import { YT_PLAY, ICON } from "../lib/icons.js";

const feat = longform[0];
const restLong = longform.slice(1);
const gridShorts = shorts.slice(0, 18);
const has = longform.length > 0 || shorts.length > 0;
---
<Base title="Videos" description="4K 60fps HDR gameplay, full walkthroughs and Shorts from BOSS KG.">
  <SectionNav current="/videos/" />
  <main id="main" class="wrap">
    <header class="page-head">
      <h1>Videos</h1>
      <p class="lede">Full 4K 60fps HDR playthroughs and quick Shorts from the BOSS KG channel.</p>
    </header>

    {!has && (
      <p class="empty">New videos are on the way. <a href={CHANNEL_URL} rel="noopener">Watch on YouTube</a>.</p>
    )}

    {feat && (
      <section class="sec" style="margin-top:var(--s6)" aria-labelledby="hFeat">
        <a class="vfeat" href={`/watch/${feat.slug}/`}>
          <div class="vthumb">
            <img src={feat.thumb.replace("hqdefault", "sddefault")} alt={feat.title} width="640" height="480"
              loading="eager" fetchpriority="high" decoding="async"
              onerror="this.onerror=null;this.src=this.src.replace('sddefault','hqdefault')" />
            <span class="play" set:html={YT_PLAY}></span>
          </div>
          <div style="margin-top:var(--s4)">
            <span class="chip">Latest full video</span>
            <h2 id="hFeat" style="font-size:clamp(24px,3vw,34px); margin-top:var(--s2)">{feat.title}</h2>
            <p class="card-date" style="margin-top:var(--s2)">{fmtDate(feat.published)}</p>
          </div>
        </a>
      </section>
    )}

    {restLong.length > 0 && (
      <section class="sec" aria-labelledby="hFull">
        <SectionHead id="hFull" title="Full videos" href={CHANNEL_URL} more="YouTube channel" ext />
        <div class="vgrid">{restLong.map((v) => <VideoCard v={v} showDate />)}</div>
      </section>
    )}

    {gridShorts.length > 0 && (
      <section class="sec" aria-labelledby="hShorts">
        <SectionHead id="hShorts" title="Shorts" href={`${CHANNEL_URL}/shorts`} more="More on YouTube" ext />
        <div class="sgrid">{gridShorts.map((v) => <VideoCard v={v} short />)}</div>
      </section>
    )}

    <div class="sec">
      <a class="btn btn-primary" href={CHANNEL_URL} rel="noopener"><Fragment set:html={ICON.youtube} /><span>Subscribe on YouTube</span></a>
    </div>

    <NewsletterBox />
  </main>
</Base>
