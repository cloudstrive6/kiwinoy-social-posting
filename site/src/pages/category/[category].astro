---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

// NOTE: getStaticPaths runs in its own isolated scope, so all the data + filtering
// lives inside it and each section passes plain, serializable props to the page.
export async function getStaticPaths() {
  const SECTIONS = {
    "marvel-games": {
      title: "Marvel Games",
      blurb: "Insomniac's Spider-Man, Wolverine and the rest of Marvel's game slate.",
      match: (d) =>
        ["spider-man2", "spider-man", "spider-man1", "miles", "wolverine"].includes((d.game || "").toLowerCase()) ||
        /wolverine|spider|marvel games/i.test(d.category || ""),
    },
    mcu: {
      title: "MCU",
      blurb: "Movies, shows and the wider Marvel Cinematic Universe.",
      match: (d) => (d.game || "").toLowerCase() === "mcu" || /mcu/i.test(d.category || ""),
    },
    playstation: {
      title: "PlayStation",
      blurb: "PS5 news, updates and performance deep-dives.",
      match: (d) => /playstation|ps5|pssr/i.test(d.category || ""),
    },
    news: {
      title: "Latest News",
      blurb: "Everything from BOSS KG — newest first.",
      match: () => true,
    },
  };

  const gmap = { wolverine: "g-wolv", "spider-man2": "g-spidey", "spider-man": "g-spidey", mcu: "g-mcu", playstation: "g-ps", marvel: "g-marvel" };
  const gclass = (g) => gmap[(g || "").toLowerCase()] || "g-marvel";
  const fmt = (d) => new Date(d).toLocaleDateString("en-US", { month: "short", day: "numeric" });

  const all = (await getCollection("articles", ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return Object.entries(SECTIONS).map(([category, sec]) => ({
    params: { category },
    props: {
      title: sec.title,
      blurb: sec.blurb,
      items: all
        .filter((a) => sec.match(a.data))
        .map((a) => ({
          id: a.id,
          title: a.data.title,
          category: a.data.category,
          tag: a.data.tag,
          cover: a.data.cover ?? null,
          coverAlt: a.data.coverAlt ?? "",
          gclass: gclass(a.data.game),
          dateLabel: fmt(a.data.date),
        })),
    },
  }));
}

const { title, blurb, items } = Astro.props;
---
<Base title={`${title} — BOSS KG`} description={blurb}>
  <main class="wrap">
    <section class="sec" style="margin-top:34px">
      <div class="sec-h"><span class="bar"></span><h2>{title}</h2><a href="/">← Home</a></div>
      <p style="color:var(--muted); margin:-6px 0 22px; max-width:60ch">{blurb}</p>
      {items.length ? (
        <div class="grid">
          {items.map((a) => (
            <a class="card" href={`/news/${a.id}`}>
              <div class={`art ${a.gclass} ${a.cover ? "has-img" : ""}`}>
                {a.cover && <img src={a.cover} alt={a.coverAlt} />}
                <span class={`pill ${a.tag === "Hot" ? "red dot" : "news"}`}>{a.tag}</span>
              </div>
              <div class="body"><span class="cat">{a.category}</span><h3>{a.title}</h3><span class="t">{a.dateLabel}</span></div>
            </a>
          ))}
        </div>
      ) : (
        <p style="color:var(--muted); padding:30px 0">No stories in this section yet — <a href="/" style="color:var(--red)">see the latest drops</a>.</p>
      )}
    </section>
  </main>
</Base>
