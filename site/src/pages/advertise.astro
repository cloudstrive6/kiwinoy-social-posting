---
import Base from "../layouts/Base.astro";
const email = "hello@bosskg.com";
---
<Base title="Advertise — BOSS KG" description="Reach the BOSS KG audience of Marvel-games and MCU fans across web, YouTube and socials.">
  <main class="wrap">
    <article class="article">
      <div class="a-head"><h1>Advertise with BOSS KG</h1></div>
      <div class="prose">
        <p>
          BOSS KG reaches a passionate audience of Marvel-games, PlayStation and MCU fans
          across our website, YouTube channel and social platforms. If you've got a game,
          product or brand that fits, let's talk.
        </p>
        <h2>Ways to partner</h2>
        <p>
          Sponsored gameplay and integrations, dedicated video coverage, social campaigns,
          and display placements on this site. We only take on partnerships that make sense
          for our audience.
        </p>
        <h2>Display advertising</h2>
        <p>
          This site runs standard display advertising from vetted networks. Ads are clearly
          labelled and never interfere with the reading experience.
        </p>
        <h2>Get a media kit</h2>
        <p>
          Email <a href={`mailto:${email}`}>{email}</a> with a bit about your brand and
          goals, and we'll send current audience numbers and rates.
        </p>
      </div>
    </article>
  </main>
</Base>
