---
import "../styles/global.css";
export interface Props {
  title?: string;
  description?: string;
}
const {
  title = "KiwinoyGamer — Gaming & Marvel News",
  description = "The drop-first source for Marvel games, the MCU, and the biggest moments in gaming.",
} = Astro.props;
const nav = [
  { label: "News", href: "/" },
  { label: "Marvel Games", href: "/category/marvel-games" },
  { label: "MCU", href: "/category/mcu" },
  { label: "Videos", href: "/videos" },
  { label: "Follow", href: "/follow" },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Cpath d='M20 2 34.6 10.4V29.6L20 38 5.4 29.6V10.4Z' fill='%23F3313E'/%3E%3C/svg%3E" />
    <!-- Set the theme before paint to avoid a flash -->
    <script is:inline>
      (function () {
        const s = localStorage.getItem("kg-theme");
        if (s) document.documentElement.setAttribute("data-theme", s);
      })();
    </script>
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-in">
        <a class="brand" href="/" aria-label="KiwinoyGamer home">
          <svg class="mark" viewBox="0 0 40 40" aria-hidden="true">
            <defs><linearGradient id="kgm" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#F3313E"/><stop offset="1" stop-color="#B3121C"/></linearGradient></defs>
            <path d="M20 2 34.6 10.4V29.6L20 38 5.4 29.6V10.4Z" fill="url(#kgm)"/>
            <path d="M20 2 34.6 10.4V29.6L20 38 5.4 29.6V10.4Z" fill="none" stroke="#FFD23C" stroke-width="1.4" opacity=".8"/>
            <text x="20" y="26" text-anchor="middle" font-family="Segoe UI,sans-serif" font-size="15" font-weight="800" fill="#fff">KG</text>
          </svg>
          <div><b>Kiwinoy</b><span>Gamer</span></div>
        </a>
        <nav class="main" aria-label="Primary">
          {nav.map((n) => (
            <a href={n.href} class={path === n.href ? "active" : ""}>{n.label}</a>
          ))}
        </nav>
        <div class="nav-right">
          <button class="iconbtn" id="theme" aria-label="Toggle light/dark theme">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/></svg>
          </button>
          <a class="btn sub" href="/#subscribe">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 6 12 13 2 6"/></svg>
            <span>Subscribe</span>
          </a>
        </div>
      </div>
    </header>

    <slot />

    <footer class="site">
      <div class="wrap foot">
        <div class="about">
          <a class="brand" href="/">
            <svg class="mark" viewBox="0 0 40 40" aria-hidden="true"><path d="M20 2 34.6 10.4V29.6L20 38 5.4 29.6V10.4Z" fill="url(#kgm)"/><path d="M20 2 34.6 10.4V29.6L20 38 5.4 29.6V10.4Z" fill="none" stroke="#FFD23C" stroke-width="1.4" opacity=".8"/><text x="20" y="26" text-anchor="middle" font-family="Segoe UI,sans-serif" font-size="15" font-weight="800" fill="#fff">KG</text></svg>
            <div><b>Kiwinoy</b><span>Gamer</span></div>
          </a>
          <p>The drop-first source for Marvel games, the MCU, and the biggest moments in gaming.</p>
          <div class="socrow">
            <a href="https://instagram.com/kiwinoygaming" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg></a>
            <a href="https://tiktok.com/@kiwinoygamer" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M16 3c.3 2.3 1.9 4 4 4.2v2.8c-1.5 0-2.9-.4-4-1.1v6.4a5.9 5.9 0 1 1-5.9-5.9c.3 0 .6 0 .9.1v2.9a3 3 0 1 0 2.1 2.9V3H16Z"/></svg></a>
            <a href="https://youtube.com/@kiwinoygamer" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M23 12s0-3.3-.4-4.9a2.6 2.6 0 0 0-1.8-1.8C19.1 5 12 5 12 5s-7.1 0-8.8.3A2.6 2.6 0 0 0 1.4 7.1C1 8.7 1 12 1 12s0 3.3.4 4.9a2.6 2.6 0 0 0 1.8 1.8C4.9 19 12 19 12 19s7.1 0 8.8-.3a2.6 2.6 0 0 0 1.8-1.8C23 15.3 23 12 23 12ZM10 15V9l5 3Z"/></svg></a>
            <a href="https://facebook.com/kiwinoygamer" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 9V7c0-1 .3-1.5 1.6-1.5H17V2.2C16.5 2.1 15.4 2 14.2 2 11.6 2 10 3.6 10 6.4V9H7.5v3.5H10V22h4v-9.5h2.7l.4-3.5H14Z"/></svg></a>
          </div>
        </div>
        <div><h4>Sections</h4><ul><li><a href="/category/marvel-games">Marvel Games</a></li><li><a href="/category/mcu">MCU</a></li><li><a href="/category/playstation">PlayStation</a></li><li><a href="/videos">Videos</a></li></ul></div>
        <div><h4>KiwinoyGamer</h4><ul><li><a href="/about">About</a></li><li><a href="/contact">Contact</a></li><li><a href="/advertise">Advertise</a></li><li><a href="/follow">Follow us</a></li></ul></div>
        <div><h4>Legal</h4><ul><li><a href="/privacy">Privacy Policy</a></li><li><a href="/terms">Terms of Use</a></li><li><a href="/editorial-standards">Editorial Standards</a></li></ul></div>
      </div>
      <div class="wrap foot-b">
        <span>© {new Date().getFullYear()} KiwinoyGamer. All rights reserved.</span><span class="dot"></span>
        <span>Made for gamers, by gamers.</span><span class="dot"></span>
        <span>All game &amp; film imagery belongs to their respective owners; used for editorial coverage.</span>
      </div>
    </footer>

    <script is:inline>
      document.getElementById("theme")?.addEventListener("click", () => {
        const root = document.documentElement;
        const dark = matchMedia("(prefers-color-scheme:dark)").matches;
        const cur = root.getAttribute("data-theme") || (dark ? "dark" : "light");
        const next = cur === "dark" ? "light" : "dark";
        root.setAttribute("data-theme", next);
        localStorage.setItem("kg-theme", next);
      });
    </script>
  </body>
</html>
