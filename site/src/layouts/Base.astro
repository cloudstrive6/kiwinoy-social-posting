---
import "../styles/global.css";
import Logo from "../components/Logo.astro";
export interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const {
  title = "BOSS KG — Gaming & Marvel News",
  description = "The drop-first source for video games, the MCU, and the biggest moments in gaming.",
  image = "/og-default.png",
} = Astro.props;
// Absolute URL for og:image (social scrapers require a full URL, not a site-relative path).
const site = Astro.site ?? new URL("https://bosskg.com");
const ogImage = image.startsWith("http") ? image : new URL(image, site).href;
const canonical = new URL(Astro.url.pathname, site).href;
const nav = [
  { label: "News", href: "/" },
  { label: "Games", href: "/games" },
  { label: "MCU", href: "/category/mcu" },
  { label: "Videos", href: "/videos" },
  { label: "Follow", href: "/follow" },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="BOSS KG" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-in">
        <a class="brand" href="/" aria-label="BOSS KG home">
          <Logo />
        </a>
        <nav class="main" aria-label="Primary">
          {nav.map((n) => (
            <a href={n.href} class={path === n.href ? "active" : ""}>{n.label}</a>
          ))}
        </nav>
        <div class="nav-right">
          <a class="iconbtn" href="/search" aria-label="Search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
          </a>
          <a class="btn sub" href="/#subscribe">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 6 12 13 2 6"/></svg>
            <span>Subscribe</span>
          </a>
          <button class="hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="mobileMenu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
          </button>
        </div>
      </div>
      <nav class="mobile-menu" id="mobileMenu" aria-label="Mobile">
        {nav.map((n) => (
          <a href={n.href} class={path === n.href ? "active" : ""}>{n.label}</a>
        ))}
        <a class="sub-cta" href="/#subscribe">Subscribe</a>
      </nav>
    </header>

    <slot />

    <footer class="site">
      <div class="wrap foot">
        <div class="about">
          <a class="brand" href="/">
            <Logo />
          </a>
          <p>The drop-first source for video games, the MCU, and the biggest moments in gaming.</p>
          <div class="socrow">
            <a href="https://instagram.com/kiwinoygaming" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg></a>
            <a href="https://tiktok.com/@kiwinoygamer" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M16 3c.3 2.3 1.9 4 4 4.2v2.8c-1.5 0-2.9-.4-4-1.1v6.4a5.9 5.9 0 1 1-5.9-5.9c.3 0 .6 0 .9.1v2.9a3 3 0 1 0 2.1 2.9V3H16Z"/></svg></a>
            <a href="https://www.youtube.com/@Kiwinoy" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M23 12s0-3.3-.4-4.9a2.6 2.6 0 0 0-1.8-1.8C19.1 5 12 5 12 5s-7.1 0-8.8.3A2.6 2.6 0 0 0 1.4 7.1C1 8.7 1 12 1 12s0 3.3.4 4.9a2.6 2.6 0 0 0 1.8 1.8C4.9 19 12 19 12 19s7.1 0 8.8-.3a2.6 2.6 0 0 0 1.8-1.8C23 15.3 23 12 23 12ZM10 15V9l5 3Z"/></svg></a>
            <a href="https://www.facebook.com/KiwinoyGaming" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 9V7c0-1 .3-1.5 1.6-1.5H17V2.2C16.5 2.1 15.4 2 14.2 2 11.6 2 10 3.6 10 6.4V9H7.5v3.5H10V22h4v-9.5h2.7l.4-3.5H14Z"/></svg></a>
          </div>
        </div>
        <div><h4>Sections</h4><ul><li><a href="/games">Games</a></li><li><a href="/category/mcu">MCU</a></li><li><a href="/videos">Videos</a></li><li><a href="/category/news">All news</a></li></ul></div>
        <div><h4>BOSS KG</h4><ul><li><a href="/about">About</a></li><li><a href="/contact">Contact</a></li><li><a href="/advertise">Advertise</a></li><li><a href="/follow">Follow us</a></li></ul></div>
        <div><h4>Legal</h4><ul><li><a href="/privacy">Privacy Policy</a></li><li><a href="/terms">Terms of Use</a></li><li><a href="/editorial-standards">Editorial Standards</a></li></ul></div>
      </div>
      <div class="wrap foot-b">
        <span>© {new Date().getFullYear()} BOSS KG. All rights reserved.</span><span class="dot"></span>
        <span>Made for gamers, by gamers.</span><span class="dot"></span>
        <span>All game &amp; film imagery belongs to their respective owners; used for editorial coverage.</span>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var b = document.getElementById("hamburger"), m = document.getElementById("mobileMenu");
        if (!b || !m) return;
        b.addEventListener("click", function () {
          var open = m.classList.toggle("open");
          b.setAttribute("aria-expanded", open ? "true" : "false");
        });
      })();
    </script>
  </body>
</html>
